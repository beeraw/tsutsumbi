###> tsutsumbi-mcp ###
/mcp/node_modules/
# Yarn 4 with nodeLinker node-modules: only the install state is local, the lock
# file stays under version control.
/mcp/.yarn/*
!/mcp/.yarn/patches
!/mcp/.yarn/plugins
!/mcp/.yarn/releases
!/mcp/.yarn/versions
/mcp/.pnp.*
/mcp/yarn-error.log
