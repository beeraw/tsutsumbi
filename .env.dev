# Development runs on the Docker instance (deploy/local/compose.yaml): bin/console on the Mac uses its database
# container, published on 127.0.0.1:3326. The container sets its own DATABASE_URL, which wins over this file; the
# test environment does not read it and stays on the Mac's MariaDB (tsutsumbi_test).
DATABASE_URL="mysql://tsutsumbi:tsutsumbi@127.0.0.1:3326/tsutsumbi?serverVersion=mariadb-12.3.3&charset=utf8mb4"

###> symfony/framework-bundle ###
