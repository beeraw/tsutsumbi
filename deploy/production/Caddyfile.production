# Block of tsutsumbi.beeraw.yt in /etc/caddy/Caddyfile on rossem, once the site runs in Docker: the same block as
# before, php_fastcgi and file_server replaced by a proxy to FrankenPHP (which serves public/ itself). lb_try_duration
# holds the requests during the few seconds a release restarts the container, instead of answering 502. The ?
# prefix is kept: tsutsumbi sets its own Strict-Transport-Security, Caddy's is only a fallback.
https://tsutsumbi.beeraw.yt {
	import block_probes
	import block_bots

	encode zstd gzip
	reverse_proxy 127.0.0.1:8100 {
		lb_try_duration 15s
		health_uri /healthz
	}
	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	log {
		output file /var/log/caddy/tsutsumbi.beeraw.yt.access.log
	}
}
