{#
   Tabler icons (MIT), inlined. They are markup rather than an icon font or a
   sprite request: the policy serves everything from this origin anyway, and a
   handful of paths costs less than a file.

   Every icon is decorative — each one sits next to a label, or inside a control
   that carries its own accessible name — so they are all aria-hidden.
#}

{% macro base(paths, size) %}
    <svg width="{{ size|default(17) }}" height="{{ size|default(17) }}" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.75"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths|raw }}</svg>
{% endmacro %}

{% macro projects(size) %}
    {{ _self.base('<path d="M4 4h6v6h-6z"/><path d="M14 4h6v6h-6z"/><path d="M4 14h6v6h-6z"/><path d="M14 14h6v6h-6z"/>', size) }}
{% endmacro %}

